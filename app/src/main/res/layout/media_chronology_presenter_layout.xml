<?xml version="1.0" encoding="utf-8"?>
<com.revolgenx.anilib.ui.view.widgets.AlCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chronology_container"
    style="@style/Widget.DynamicApp.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
            android:id="@+id/chronology_position_tv"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold"
            app:adt_colorType="accent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="12" />

        <com.pranavpandey.android.dynamic.support.widget.DynamicFrameLayout
            android:id="@+id/chronology_cover_container"
            android:layout_width="100dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1.4"
            app:layout_constraintStart_toEndOf="@+id/chronology_position_tv"
            app:layout_constraintTop_toTopOf="parent">

            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/chronology_cover_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundAsCircle="false"
                app:roundedCornerRadius="6dp" />

            <com.revolgenx.anilib.ui.view.score.MediaScoreBadge
                android:id="@+id/chronology_score_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="3dp" />

        </com.pranavpandey.android.dynamic.support.widget.DynamicFrameLayout>

        <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
            android:id="@+id/chronology_title_tv"
            style="@style/TitleFontStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chronology_cover_container"
            app:layout_constraintTop_toTopOf="@+id/chronology_cover_container"
            tools:text="Fate/stay night: Unlimited Blade Works" />

        <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
            android:id="@+id/chronology_relation_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp"
            app:adt_colorType="accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chronology_cover_container"
            app:layout_constraintTop_toBottomOf="@+id/chronology_title_tv"
            tools:ignore="SmallSp"
            tools:text="Sequel · TV" />

        <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
            android:id="@+id/chronology_meta_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chronology_cover_container"
            app:layout_constraintTop_toBottomOf="@+id/chronology_relation_tv"
            tools:ignore="SmallSp"
            tools:text="26 ep × 24 min · 10h 24m" />

        <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
            android:id="@+id/chronology_date_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chronology_cover_container"
            app:layout_constraintTop_toBottomOf="@+id/chronology_meta_tv"
            tools:ignore="SmallSp"
            tools:text="Oct 2014 – Jun 2015 · Finished" />

        <com.revolgenx.anilib.ui.view.IndicatorTextView
            android:id="@+id/chronology_list_status_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chronology_cover_container"
            app:layout_constraintTop_toBottomOf="@+id/chronology_date_tv"
            app:layout_constraintVertical_bias="0"
            app:textColorType="text_primary"
            app:textSize="11" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolgenx.anilib.ui.view.widgets.AlCardView>
