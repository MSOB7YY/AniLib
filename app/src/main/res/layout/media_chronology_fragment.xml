<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.revolgenx.anilib.common.ui.view.AlAppBarLayout
        style="@style/AlAppBarLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.revolgenx.anilib.common.ui.view.AlToolbar
            android:id="@+id/dynamicToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:adt_colorType="background"
            app:adt_textColorType="text_primary"
            app:contentInsetLeft="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:layout_scrollFlags="noScroll"
            app:subtitleTextAppearance="@style/DynamicToolbarSubTitleTheme"
            app:titleTextAppearance="@style/DynamicToolbarTitleTheme" />

    </com.revolgenx.anilib.common.ui.view.AlAppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.revolgenx.anilib.common.ui.view.AlTextTabLayout
            android:id="@+id/chronology_order_tab_layout"
            style="@style/HomeContainerTabLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:adt_backgroundColorType="background"
            app:adt_colorType="accent"
            app:adt_contrastWithColorType="background"
            app:adt_textColorType="text_primary"
            app:entries="@array/media_chronology_order"
            app:tabMode="fixed"
            app:tabTextAppearance="@style/ListTabLayoutTextStyle" />

        <HorizontalScrollView
            android:id="@+id/chronology_filter_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chronology_filter_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true"
                app:singleSelection="false" />

        </HorizontalScrollView>

        <com.revolgenx.anilib.ui.view.widgets.AlCardView
            android:id="@+id/chronology_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                        android:id="@+id/chronology_entries_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:adt_colorType="accent"
                        tools:text="14" />

                    <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/entries"
                        android:textSize="10sp"
                        tools:ignore="SmallSp" />

                </com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout>

                <com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                        android:id="@+id/chronology_episodes_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:adt_colorType="accent"
                        tools:text="163" />

                    <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                        android:id="@+id/chronology_episodes_label_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/episodes"
                        android:textSize="10sp"
                        tools:ignore="SmallSp" />

                </com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout>

                <com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                        android:id="@+id/chronology_runtime_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:adt_colorType="accent"
                        tools:text="65h 12m" />

                    <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_runtime"
                        android:textSize="10sp"
                        tools:ignore="SmallSp" />

                </com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout>

            </com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout>

        </com.revolgenx.anilib.ui.view.widgets.AlCardView>

        <LinearLayout
            android:id="@+id/chronology_notice_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.pranavpandey.android.dynamic.support.widget.DynamicImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="5dp"
                app:adt_colorType="accent"
                app:srcCompat="@drawable/ic_error" />

            <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                android:id="@+id/chronology_notice_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                app:adt_colorType="accent"
                tools:ignore="SmallSp"
                tools:text="More entries available" />

            <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                android:id="@+id/chronology_load_more_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:text="@string/load_more"
                android:textSize="11sp"
                android:textStyle="bold"
                app:adt_colorType="accent"
                tools:ignore="SmallSp" />

        </LinearLayout>

        <com.pranavpandey.android.dynamic.support.widget.DynamicSwipeRefreshLayout
            android:id="@+id/chronology_swipe_to_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:adt_colorType="accent_dark">

            <com.pranavpandey.android.dynamic.support.widget.DynamicRecyclerView
                android:id="@+id/chronology_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="48dp"
                android:scrollbars="none"
                app:adt_windowInsets="false" />

        </com.pranavpandey.android.dynamic.support.widget.DynamicSwipeRefreshLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
