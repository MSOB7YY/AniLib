<?xml version="1.0" encoding="utf-8"?>
<com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
            android:id="@+id/watch_filter_label_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="13sp"
            tools:text="Sort by" />

        <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
            android:id="@+id/watch_filter_value_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp"
            app:adt_colorType="accent"
            tools:ignore="SmallSp"
            tools:text="Latest" />

    </com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout>

    <com.pranavpandey.android.dynamic.support.widget.DynamicImageView
        android:id="@+id/watch_filter_clear_iv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:src="@drawable/ic_delete"
        app:adt_colorType="text_secondary" />

</com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout>
