<?xml version="1.0" encoding="utf-8"?>
<com.revolgenx.anilib.ui.view.widgets.AlCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.DynamicApp.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardUseCompatPadding="true">

    <com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="4dp"
        android:paddingBottom="10dp">

        <com.pranavpandey.android.dynamic.support.widget.DynamicImageView
            android:id="@+id/watch_action_drag_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_drag"
            app:adt_colorType="text_secondary" />

        <com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                android:id="@+id/watch_action_name_tv"
                style="@style/TitleFontStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp"
                tools:text="nekoBT" />

            <com.pranavpandey.android.dynamic.support.widget.DynamicTextView
                android:id="@+id/watch_action_summary_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="11sp"
                app:adt_colorType="text_secondary"
                tools:ignore="SmallSp"
                tools:text="nekobt.to · default · in app results" />

        </com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout>

        <com.pranavpandey.android.dynamic.support.widget.DynamicCheckBox
            android:id="@+id/watch_action_enabled_cb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.pranavpandey.android.dynamic.support.widget.DynamicImageView
            android:id="@+id/watch_action_menu_iv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_more_vert"
            app:adt_colorType="text_secondary" />

    </com.pranavpandey.android.dynamic.support.widget.DynamicLinearLayout>

</com.revolgenx.anilib.ui.view.widgets.AlCardView>
